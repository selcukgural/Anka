<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>

        <!-- NuGet package metadata -->
        <PackageId>Anka</PackageId>
        <Version>0.0.1-beta.5</Version>
        <Authors>Selçuk Güral</Authors>
        <Description>Minimal zero-allocation HTTP/1.x server for .NET 8+. Native AOT compatible. Built on raw sockets with a sliding receive window and pooled buffers for an allocation-free steady-state fast path.</Description>
        <PackageReleaseNotes>   Breaking changes:
   1 - Only one response per request: a second WriteAsync / WritePartialAsync / StartChunkedResponseAsync for the same request throws InvalidOperationException. New HttpResponseWriter.HasStarted.
   2 - HttpHeader and the contentType argument reject CR, LF and other control characters with ArgumentException (prevents response splitting).
   3 - The keepAlive argument can only narrow the request's choice: keepAlive: true for a request that sent Connection: close now answers Connection: close, and keepAlive: false now closes the connection.
   Behaviour changes:
   4 - A handler that writes nothing gets an empty 200; an unfinished chunked response is terminated automatically; an exception after the response started closes the connection instead of appending a 500.
   5 - Streaming (GetStream / chunked API) to HTTP/1.0 clients uses a close-delimited body instead of chunked encoding.
   Fixes:
   6 - Connection header parsed as a case-insensitive token list ("Close", "close, TE", repeated headers).
   7 - Header lines without a colon and chunk extensions with control bytes are rejected with 400.
   8 - Trailers no longer leak into the next keep-alive response; HEAD suppresses body bytes on the writer-level chunked API.
   9 - Content-Type length included in the response buffer estimate (long values could overrun the buffer).
   10 - MultipartParser: CRLF-prefixed delimiter, empty parts and header-less parts handled, Content-Disposition parameters matched by name.
   11 - Range parsing accepts only a single all-digit range.
   Tooling: CI on Ubuntu and macOS with a Native AOT smoke test; releases published from CI via NuGet Trusted Publishing.</PackageReleaseNotes>
        <PackageTags>http;server;aot;native-aot;zero-allocation;high-performance;minimal;networking;tcp;http1</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Selçuk Güral</Copyright>
        <PackageProjectUrl>https://github.com/selcukgural/Anka</PackageProjectUrl>
        <RepositoryUrl>https://github.com/selcukgural/Anka.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>anka-logo.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Include repository README in the NuGet package for the gallery page -->
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <!-- Include logo in the NuGet package -->
        <None Include="anka-logo.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Anka.Test</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Anka.Benchmark</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
