<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>

        <!-- NuGet package metadata -->
        <PackageId>Anka</PackageId>
        <Version>0.0.1-beta.6</Version>
        <Authors>Selçuk Güral</Authors>
        <Description>Minimal zero-allocation HTTP/1.x server for .NET 8+. Native AOT compatible. Built on raw sockets with a sliding receive window and pooled buffers for an allocation-free steady-state fast path.</Description>
        <PackageReleaseNotes>   Breaking changes (with migration):
   1 - HttpMethod is renamed to RequestMethod; the old name collided with System.Net.Http.HttpMethod, which ImplicitUsings imports into every console project. Replace HttpMethod with RequestMethod and drop any "using HttpMethod = Anka.HttpMethod;" alias.
   2 - MultipartParser and MultipartPart moved from Anka.Internal to the Anka namespace. Remove "using Anka.Internal;".
   3 - WriteAsync and StartChunkedResponseAsync throw ArgumentOutOfRangeException for status codes below 200 or above 999 (1xx codes cannot be a final response).
   4 - The CancellationToken passed to the handler is now cancelled when the shutdown timeout expires, not as soon as shutdown starts.
   5 - Server no longer writes "Listening on ..." to standard output. Subscribe to Server.ListeningStarted if you relied on it.
   New:
   6 - Graceful shutdown: cancelling the StartAsync token stops accepting, closes idle connections, lets requests already in the handler finish with Connection: close, and aborts the rest after ServerOptions.ShutdownTimeout (default 10 s; TimeSpan.Zero keeps the old immediate abort). StartAsync returns once every connection has ended.
   7 - IPv6 listening: host "::1" for IPv6 loopback, "::" for all interfaces (dual-stack, also accepts IPv4). ListeningStarted reports the bound endpoint.
   8 - HttpRequest.TryGetRange(length, out start, out end) resolves a single-range Range header (bytes=a-b, a-, -n) for GET requests; pass the result to WritePartialAsync.
   9 - MultipartParser.TryGetBoundary(contentType, out boundary) reads the boundary from a multipart/form-data Content-Type.
   10 - Standard reason phrases for every RFC 9110 status code plus common extensions (e.g. 422 Unprocessable Content, 502 Bad Gateway); unknown codes are sent with an empty reason phrase instead of "Unknown".
   Documentation: README rewritten as a getting-started guide with verified recipes (routing, query strings, JSON source generation, CORS, streaming, Range, ETag, uploads, Docker, shutdown) and an accurate API reference.</PackageReleaseNotes>
        <PackageTags>http;server;aot;native-aot;zero-allocation;high-performance;minimal;networking;tcp;http1</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Selçuk Güral</Copyright>
        <PackageProjectUrl>https://github.com/selcukgural/Anka</PackageProjectUrl>
        <RepositoryUrl>https://github.com/selcukgural/Anka.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>anka-logo.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Include repository README in the NuGet package for the gallery page -->
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <!-- Include logo in the NuGet package -->
        <None Include="anka-logo.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Anka.Test</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>Anka.Benchmark</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
